{
	"name": "manacube",
	"version": "2.1.0",
	"description": "Typed client for the ManaCube public API",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"keywords": [
		"mana",
		"cube",
		"manacube",
		"manacubeapi",
		"Mana Cube",
		"Mana Cube API",
		"api",
		"minecraft",
		"server",
		"client",
		"NodeJs",
		"TypeScript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nick22985/ManacubeApi.git"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run lint && npm run typecheck && npm run build && npm test",
		"smoke": "npm run build && node scripts/smoke.mjs",
		"spec:update": "node scripts/update-spec.mjs",
		"preversion": "npm run check",
		"prepublishOnly": "npm run build",
		"release": "npm version patch && git push --follow-tags",
		"release:minor": "npm version minor && git push --follow-tags",
		"release:major": "npm version major && git push --follow-tags"
	},
	"author": "nick22985",
	"license": "MIT",
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@types/node": "^22.20.5",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	}
}
